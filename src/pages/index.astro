---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import SectionContainer from "../components/SectionContainer.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import SocialPill from "../components/icons/SocialPill.astro";
import GithubIcon from "../components/icons/Github.astro";
import MailIcon from "../components/icons/Mail.astro";
import Experience from "../components/Experience.astro";
import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/Code.astro";
import Projects from "../components/Projects.astro";
---

<Layout
  title="Portfolio de Danilo Maccari"
  description="Desarrollador Full Stack"
  lang="es"
>
  <main class="px-4">
    <SectionContainer class="py-28 pb-32">
      <h1
        class="text-black dark:text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-10"
      >
        ¡Hola, soy Danilo Maccari!
        <a
          href="https://www.linkedin.com/in/maccari78/"
          target="_blank"
          rel="noopener"
          class="flex justify-center items-center"
        >
          <Badge>Disponible para trabajar</Badge>
        </a>
      </h1>
      <h2 class="text-lg lg:text-xl font-semibold text-wrap max-w-[700px] mb-3">
        Desarrollador Full Stack | Django · Ruby on Rails 8 · Next.js | Sistemas de escala gubernamental | Kubernetes / OKD | HealthTech MVP
      </h2>
      <p class="text-base lg:text-lg text-wrap max-w-[700px] text-gray-700 dark:text-gray-300">
        Desarrollador Full Stack con experiencia en <span class="font-semibold">sistemas de producción críticos</span>. Fui el único desarrollador a cargo de <span class="font-semibold">IPS RUPA</span>, plataforma gubernamental provincial (Django + Next.js + PostgreSQL) con millones de registros de afiliados, empleadores y salarios. Gestioné todas las etapas: API REST, migración de frontend, adaptación a schema legacy inamovible (Adabas D → PostgreSQL), integración de +90 GB de datos con Celery y Streaming, y deploy en Kubernetes (OKD/OpenShift) coordinado con DevOps. Paralelamente desarrollé <span class="font-semibold">DocSync</span>, un SaaS de gestión de clínicas en Rails 8, React Native, Stripe y Claude API. Sólido en código limpio, seguridad y entrega continua.
      </p>
      <ul>
        <nav class="flex gap-4 mt-8 flex-wrap">
          <SocialPill href="https://www.linkedin.com/in/maccari78/">
            <LinkedInIcon class="size-4 md:size-6" />LinkedIn
          </SocialPill>
          <SocialPill href="https://github.com/maccari78">
            <GithubIcon class="size-4 md:size-6" />Github
          </SocialPill>
          <SocialPill href="mailto:maccari78@gmail.com">
            <MailIcon class="size-4 md:size-6" />maccari78@gmail.com
          </SocialPill>
        </nav>
      </ul>
      <div class="flex gap-4 mt-6 flex-wrap justify-start">
        <a
          href="/cv/2026-03-02 MaccariDaniloCV ES.pdf"
          download="2026-03-02 MaccariDaniloCV ES.pdf"
          class="flex items-center"
        >
          <Badge
            class="px-4 py-2 text-sm md:text-base hover:bg-blue-200 dark:hover:bg-gray-700 transition-colors"
          >
            Descargar CV (Español)
          </Badge>
        </a>
        <a
          href="/cv/2026-03-02 MaccariDaniloCV EN.pdf"
          download="2026-03-02 MaccariDaniloCV EN.pdf"
          class="flex items-center"
        >
          <Badge
            class="px-4 py-2 text-sm md:text-base hover:bg-blue-200 dark:hover:bg-gray-700 transition-colors"
          >
            Download CV (English)
          </Badge>
        </a>
      </div>
    </SectionContainer>
    <SectionContainer id="experiencia">
      <h2 class="text-3xl font-semibold mb-6 flex gap-x-2 items-center">
        <Briefcase class="size-7" />
        Experiencia profesional
      </h2>
      <Experience />
    </SectionContainer>
    <SectionContainer id="proyectos">
      <h2 class="text-3xl font-semibold mb-6 flex gap-x-2 items-center">
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionContainer>
  </main>
</Layout>

<script is:inline type="text/javascript">
  function googleTranslateElementInit() {
    new google.translate.TranslateElement(
      { pageLanguage: "es" },
      "google_translate_element"
    );
  }
</script>
<script
  is:inline
  type="text/javascript"
  src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
></script>
